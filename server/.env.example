# 环境变量模板：复制为 .env 后填入真实值
#   cp .env.example .env
# 不要把填好的 .env 提交到仓库。

# ---------- 大模型（至少填一个；AGENT_VENDOR 决定用哪个）----------
AGENT_VENDOR=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---------- Agent 运行参数 ----------
DEFAULT_TIMEOUT=30
MAX_RETRY_TIMES=1
GLOBAL_MAX_CONCURRENT=5
AGENT_MAX_REACT_ROUND=5
AGENT_TIMEOUT_SECONDS=45

# ---------- Agent 成本护栏（公网部署必填）----------
# 单用户每日调用次数上限（0=不限）。演示环境 30 次足够走完所有功能
AGENT_DAILY_QUOTA_PER_USER=30
# 全局每日预算上限（元），超过后所有 AI 调用熔断，0=不限
AGENT_DAILY_BUDGET_YUAN=3.0
# 每千 token 单价（元），用于估算花费；按 qwen-plus 实际价格调整
AGENT_PRICE_PER_1K_TOKENS=0.002

ENABLE_SUMMARY_TRUNCATE=true
MAX_CONTEXT_TOKENS=8000
SUMMARY_RESERVE_RATIO=0.2

# ---------- 鉴权（生产必须改）----------
# JWT 签名密钥：同一部署的所有副本必须使用同一个值，否则出现"刚登录就过期"
# 生产环境建议由 KMS/密钥管理服务统一下发；留空时进程内随机生成（仅限本地单进程演示）
JWT_SIGNING_KEY=
# DEV_MODE 首次启动种子账号（0001 / 1001）的演示口令
# 不设置时随机生成并打印在启动日志里；生产环境不应依赖种子账号
DEMO_SEED_PASSWORD=
JWT_EXPIRE_MINUTES=10080

# ---------- 数据库 ----------
# 演示/开发用 SQLite，无需配置；生产改用 PostgreSQL 时填下面四项
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=moins
# POSTGRES_PASSWORD=
# POSTGRES_DB=moins_workbench

# ---------- 知识库 ----------
RAG_TOP_K=6
RAG_TEMPERATURE=0.1
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHROMA_PERSIST_DIR=./data/chroma
# 检索后端：keyword（默认，零依赖）| pgvector（需本地 postgres 容器）| hybrid（双路 RRF）
RAG_BACKEND=keyword
# 向量化模型（通义 text-embedding-v3，与 init-db.sql 的 vector(1024) 维度一致）
QWEN_EMBED_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ---------- 可选：OCR / 联网搜索 ----------
ENABLE_OCR=false
